# ─────────────────────────────────────────────────────────────────────────────
# offhrs — Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Production:  your live Supabase project (used in Vercel Production scope)
# Staging:     offhrs-staging project   (used in Vercel Preview scope)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── App URL ───────────────────────────────────────────────────────────────────
# Set to https://offhrs.app in production; Vercel sets VERCEL_URL automatically
# for preview deployments. Used for email links and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin Panel ───────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=<strong-password>
ADMIN_API_SECRET=<32-char-random-string>

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
CRON_SECRET=<random-string-verified-in-cron-headers>

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_<key>
RESEND_FROM_EMAIL=noreply@offhrs.app

# ── Mobile App Store Links (optional) ────────────────────────────────────────
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/offhrs/id<id>
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=<id>

# ─────────────────────────────────────────────────────────────────────────────
# SaaS BOOKING ENGINE — NEW VARIABLES (Phase 1+)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe ────────────────────────────────────────────────────────────────────
# Production:  sk_live_... / pk_live_...  (Vercel Production scope only)
# Staging:     sk_test_... / pk_test_...  (Vercel Preview scope)
# Test card:   4242 4242 4242 4242  |  any future date  |  any CVC
STRIPE_SECRET_KEY=sk_test_<key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<key>

# Webhook signing secrets — generate via Stripe Dashboard → Webhooks
# /api/webhooks/stripe  handles Billing + Connect events
STRIPE_WEBHOOK_SECRET=whsec_<billing-webhook-secret>
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_<connect-webhook-secret>

# Price ID for the $79 CAD/month Standard plan (create in Stripe Dashboard)
STRIPE_STANDARD_PRICE_ID=price_<id>

# ── Cal.com Platform API ───────────────────────────────────────────────────────
# Register at: https://app.cal.com/settings/platform
# Sandbox credentials go in Vercel Preview scope; production in Production scope.
CAL_API_KEY=cal_live_<key>
CAL_OAUTH_CLIENT_ID=<oauth-client-id>

# Webhook signing secret — set when registering the Cal.com webhook
# Endpoint: /api/webhooks/cal
CAL_WEBHOOK_SECRET=<cal-webhook-secret>

# ── Token Encryption ──────────────────────────────────────────────────────────
# AES-256 key for encrypting Cal.com access/refresh tokens at rest in Supabase.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# ─────────────────────────────────────────────────────────────────────────────
# MOBILE ATTESTATION (optional — feature-flagged)
# ─────────────────────────────────────────────────────────────────────────────
ENFORCE_MOBILE_ATTESTATION=false
PLAY_INTEGRITY_VERIFY_URL=
APP_ATTEST_VERIFY_URL=
MOBILE_ATTESTATION_SHARED_SECRET=
