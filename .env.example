# ─────────────────────────────────────────────────────────────────────────────
# offhrs — Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical URL for SEO (sitemap, OG). Production: https://offhrs.app (optional; falls back to NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_SITE_URL=https://offhrs.app

# ── Admin Panel ───────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=<strong-password>
ADMIN_API_SECRET=<32-char-random-string>

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
CRON_SECRET=<random-string>

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_<key>
RESEND_FROM_EMAIL=noreply@offhrs.app

# ── Mobile App Store Links (optional) ────────────────────────────────────────
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/offhrs/id<id>
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=<id>

# ─────────────────────────────────────────────────────────────────────────────
# SaaS BOOKING ENGINE — Phase 1+
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe (test: sk_test_... | live: sk_live_...) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_<key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<key>
STRIPE_WEBHOOK_SECRET=whsec_<billing-webhook-secret>
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_<connect-webhook-secret>
STRIPE_PRO_PRICE_ID=price_<id>
# Legacy (optional): used if STRIPE_PRO_PRICE_ID is unset.
STRIPE_STANDARD_PRO_ID=price_<id>
STRIPE_STANDARD_PRICE_ID=price_<id>
STRIPE_LITE_PRICE_ID=price_<id>

# ── Token Encryption (AES-256, base64) ───────────────────────────────────────
# Generate: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# ── Partner calendar sync (Google Calendar + Microsoft Outlook) ─────────────
# Optional: HMAC for OAuth `state` (defaults to CRON_SECRET if unset).
OAUTH_STATE_SECRET=<random-string>
# Google Cloud OAuth 2.0 (Web app). Authorized redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/partners/calendar/oauth/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Azure App registration (Multitenant + personal accounts). Redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/partners/calendar/oauth/microsoft/callback
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# IANA timezone for created calendar events (default America/Toronto).
# VENDOR_CALENDAR_DEFAULT_TZ=America/Toronto

# ─────────────────────────────────────────────────────────────────────────────
# MOBILE ATTESTATION (optional)
# ─────────────────────────────────────────────────────────────────────────────
ENFORCE_MOBILE_ATTESTATION=false
PLAY_INTEGRITY_VERIFY_URL=
APP_ATTEST_VERIFY_URL=
MOBILE_ATTESTATION_SHARED_SECRET=
