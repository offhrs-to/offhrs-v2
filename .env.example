# ─────────────────────────────────────────────────────────────────────────────
# offhrs — Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical URL for SEO (sitemap, OG). Production: https://offhrs.app (optional; falls back to NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_SITE_URL=https://offhrs.app

# ── Admin Panel ───────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=<strong-password>
ADMIN_API_SECRET=<32-char-random-string>

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
CRON_SECRET=<random-string>

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_<key>
RESEND_FROM_EMAIL=noreply@offhrs.app

# ── Mobile App Store Links (optional) ────────────────────────────────────────
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/offhrs/id<id>
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=<id>

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
# Optional: partner signup skips the widget/verification entirely if unset.
# Create a free Turnstile site at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Emergency kill switch ─────────────────────────────────────────────────────
# Set to "1" to make expensive endpoints (scrape, book, quote, confirm) return 503.
# See docs/security/BANKRUPTCY_PREVENTION_RUNBOOK.md
DISABLE_EXPENSIVE_ENDPOINTS=0

# ─────────────────────────────────────────────────────────────────────────────
# SaaS BOOKING ENGINE — Phase 1+
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe (test: sk_test_... | live: sk_live_...) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_<key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<key>
STRIPE_WEBHOOK_SECRET=whsec_<billing-webhook-secret>
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_<connect-webhook-secret>
# Recurring monthly prices in Stripe (CAD): Lite $29/mo, Pro $49/mo, both with 30-day trial at checkout.
STRIPE_LITE_PRICE_ID=price_<lite_29_cad_monthly>
STRIPE_PRO_PRICE_ID=price_<pro_49_cad_monthly>
# Legacy (optional): used if STRIPE_PRO_PRICE_ID is unset.
STRIPE_STANDARD_PRO_ID=price_<id>
STRIPE_STANDARD_PRICE_ID=price_<id>
# Optional: Stripe Tax product codes
# STRIPE_WORKSHOP_TAX_CODE=txcd_20030000
# Tangible goods (Artist Marketplace) — confirm in Stripe Tax dashboard before live remittance
# STRIPE_SHOP_GOODS_TAX_CODE=txcd_99999999

# ── Artist Marketplace (Phase 0+) ─────────────────────────────────────────────
# Platform fee in basis points (500 = 5% of item subtotal). Stripe processing is separate.
SHOP_PLATFORM_FEE_BPS=500
# Auto signature + insurance above this item price (CAD)
SHOP_HIGH_VALUE_INSURANCE_CAD=250
# Shippo platform API key (server only). Canada Post via Shippo master account.
# SHIPPO_API_KEY=shippo_test_...
# Optional webhook token when Shippo tracking webhooks POST to /api/webhooks/shippo
# SHIPPO_WEBHOOK_SECRET=
# Optional: pin Canada Post carrier account object_id for rate requests
# SHIPPO_CANADA_POST_CARRIER_ACCOUNT_ID=

# Google Places (server) — shop checkout address autocomplete (/api/places/*).
# Prefer a server key (not HTTP-referrer-only). Places API must be enabled.
# GOOGLE_MAPS_API_KEY=
# Fallback also checked: NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (partner web Places)

# ── Token Encryption (AES-256, base64) ───────────────────────────────────────
# Generate: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# ── Partner calendar sync (Google Calendar + Microsoft Outlook) ─────────────
# Optional: HMAC for OAuth `state` (defaults to CRON_SECRET if unset).
OAUTH_STATE_SECRET=<random-string>
# Google Cloud OAuth 2.0 (Web app). Authorized redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/partners/calendar/oauth/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Azure App registration (Multitenant + personal accounts). Redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/partners/calendar/oauth/microsoft/callback
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# IANA timezone for created calendar events (default America/Toronto).
# VENDOR_CALENDAR_DEFAULT_TZ=America/Toronto

# ── Shopify workshop feed (optional) ─────────────────────────────────────────
# Custom/public Shopify app. Redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/partners/shopify/callback
# Webhook endpoint (register on install):
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/shopify
# Vendor product tag: offhrs_workshop
# Metafields (namespace offhrs): starts_at, optional book_url, capacity, duration_minutes, category
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Optional; default read_products,read_inventory
# SHOPIFY_SCOPES=read_products,read_inventory

# ─────────────────────────────────────────────────────────────────────────────
# MOBILE ATTESTATION (optional)
# ─────────────────────────────────────────────────────────────────────────────
ENFORCE_MOBILE_ATTESTATION=false
PLAY_INTEGRITY_VERIFY_URL=
APP_ATTEST_VERIFY_URL=
MOBILE_ATTESTATION_SHARED_SECRET=
