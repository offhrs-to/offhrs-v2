{
  "expo": {
    "name": "offhrs-mobile",
    "slug": "offhrs-mobile",
    "version": "1.2.29",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "offhrsmobile",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ECEFE5",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.offhrs.app.offhrs",
      "buildNumber": "30",
      "backgroundColor": "#ECEFE5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Offhrs uses your location to show workshops near you and sort results by distance. You can enter a postal code instead."
      }
    },
    "android": {
      "package": "com.offhrs.app",
      "versionCode": 34,
      "launchMode": "singleTask",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "offhrsmobile",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Offhrs uses your location to show workshops near you and sort results by distance. You can enter a postal code instead."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1014e351-ffd9-4953-b655-a54559e93f12"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1014e351-ffd9-4953-b655-a54559e93f12"
      }
    },
    "owner": "offhrs"
  }
}
