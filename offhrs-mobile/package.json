{
  "name": "offhrs-mobile",
  "main": "expo-router/entry",
  "version": "1.3.8",
  "scripts": {
    "start": "expo start",
    "build:ios": "cross-env EXPO_NO_CAPABILITY_SYNC=1 npx eas-cli build --platform ios --profile production",
    "build:android": "npx eas-cli build --platform android --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production --latest",
    "generate-icon": "node scripts/generate-app-icon.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env EXPO_ANDROID_SPLASH=1 expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "submit:android": "npx eas-cli submit --platform android --profile production --latest",
    "app-store-screenshots": "node scripts/render-app-store-screenshots.mjs",
    "resize-ipad-13-screenshots": "node scripts/resize-app-store-ipad-13-screenshots.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.1.0",
    "@react-navigation/elements": "^2.2.0",
    "@react-navigation/native": "^7.1.0",
    "@stripe/stripe-react-native": "0.64.0",
    "@supabase/supabase-js": "^2.93.2",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-heroicons": "^4.0.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "private": true
}
